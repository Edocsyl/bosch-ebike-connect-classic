# openssl rand -base64 48   (>= 32 chars; losing/changing it invalidates all stored sessions)
GATEWAY_SECRET=
# Externally visible base URL, no trailing slash. Must match what Claude connects to.
PUBLIC_URL=https://ebike.example.com
# Set to 1 only when behind Cloudflare / a trusted proxy (uses CF-Connecting-IP for rate limits)
TRUST_PROXY=0
# Extra browser origins allowed to call /mcp (comma separated), only for browser-based MCP clients
ALLOWED_ORIGINS=

# --- Docker Compose only (not read by the app) ---
# Host folder for persistent data (SQLite with encrypted sessions); default ./config
#DATA_PATH=./config
# Numeric user / group that owns DATA_PATH on the host (run `id -u` and `id -g`); default 1000
#PUID=1000
#PGID=1000
# Published image and version to run; default ghcr.io/edocsyl/bosch-ebike-connect-classic:1.0.0
#IMAGE=ghcr.io/edocsyl/bosch-ebike-connect-classic
#IMAGE_TAG=1.0.0
