# openssl rand -base64 48   (>= 32 chars; losing/changing it invalidates all stored sessions)
GATEWAY_SECRET=
# Externally visible base URL, no trailing slash. Must match what Claude connects to.
PUBLIC_URL=https://ebike.example.com
# Set to 1 only when behind Cloudflare / a trusted proxy (uses CF-Connecting-IP for rate limits)
TRUST_PROXY=0
# Extra browser origins allowed to call /mcp (comma separated), only for browser-based MCP clients
ALLOWED_ORIGINS=
